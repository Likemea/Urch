# Urch environment variables

# Required
BOT_TOKEN=your_discord_bot_token_here       # Discord Developer Portal -> Bot -> Token
GROQ_API_KEY=your_groq_api_key_here         # https://console.groq.com/keys
POLLINATIONS_API_KEY=your_pollinations_key  # https://enter.pollinations.ai
GOOGLE_API_KEY=your_google_api_key_here     # https://aistudio.google.com/apikey

# Optional
BACKUP_KEEP=7                               # Number of daily DB backups kept in ./backups
